# Azure OpenAI 設定
# ローカル開発用 .env ファイルです。実際のAPIキーはリポジトリに含めないでください。
# Azure 本番環境では AZURE_OPENAI_API_KEY を Container Apps Secret として管理してください。
# 詳細: docs/azure-deployment.md「Secret 管理」セクションを参照
AZURE_OPENAI_ENDPOINT=https://ai-hackathon-free-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Microsoft Foundry / Agent Service 用（将来拡張用）
# 現バージョンでは使用しませんが、将来のAzure AI Agent Service連携時に使用します
AZURE_AI_PROJECT_ENDPOINT=https://ai-hackathon-free-resource.services.ai.azure.com/api/projects/ai-hackathon-free
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini
